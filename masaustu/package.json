{
  "name": "birlikte-izle-motor-masaustu",
  "version": "0.7.48",
  "private": true,
  "type": "module",
  "description": "Birlikte Ä°zle masaÃ¼stÃ¼ istemcisi: Electron kabuÄŸu + gÃ¶mÃ¼lÃ¼ mpv",
  "main": "electron/baslat.cjs",
  "scripts": {
    "start": "electron .",
    "paketle:ortak": "node motor-kopyala.cjs && electron-packager . \"Birlikte Izle Motor\" --platform=win32 --arch=x64 --overwrite --icon=electron/simge.ico --extra-resource=mpv --ignore=\"(^/node_modules$|^/dagitim|^/mpv$|^/electron/gomme-kaniti|^/electron/kanit\\.html|^/electron/onyukleme\\.cjs$)\"",
    "paketle": "npm run paketle:ortak -- --out=dagitim",
    "kurulum": "npm run paketle:ortak -- --out=dagitim-kurulum && electron-builder --win nsis --x64 --prepackaged \"dagitim-kurulum/Birlikte Izle Motor-win32-x64\" --config kurulum.config.json"
  },
  "build": {
    "appId": "xyz.birlikteizle.motor.masaustu",
    "productName": "Birlikte Izle Motor",
    "directories": {
      "output": "dagitim"
    },
    "files": [
      "electron/**",
      "*.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  }
}
